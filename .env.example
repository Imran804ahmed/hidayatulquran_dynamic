# Hidayatul Quran website + admin portal configuration.
# Copy to .env.local for local development. In production set these in the hosting panel
# (Hostinger Node.js app "Environment variables") or in a .env file readable only by the app user.
# Never commit real values.

# --- Database (MySQL / MariaDB; the existing website database) ---
DB_HOST=localhost
DB_PORT=3306
DB_NAME=your_database_name
DB_USER=your_database_user
DB_PASSWORD=change-me
DB_POOL_SIZE=5

# --- Email (SMTP). Hostinger: smtp.hostinger.com, port 587 (STARTTLS) or 465 (TLS) ---
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=587
SMTP_USER=info@example.com
SMTP_PASSWORD=change-me
MAIL_FROM=info@example.com
MAIL_FROM_NAME=Hidayatul Quran
# Development only: MAIL_MODE=log prints emails to the server log instead of sending them.
# MAIL_MODE=log

# --- Site ---
# Public origin, used in password-reset links and staff notification links.
PUBLIC_SITE_URL=https://www.hidayatulquran.com
# Redirects every request to https://<CANONICAL_HOST> (replaces the old .htaccess rule).
# Leave empty if the host / reverse proxy already does this.
CANONICAL_HOST=www.hidayatulquran.com
# Set to 1 when running behind a reverse proxy that sets X-Forwarded-For (Hostinger Node.js
# hosting, nginx, Cloudflare). Enables per-IP rate limits. Leave unset when Node is exposed directly.
TRUST_PROXY=1
# Session cookie "Secure" flag. Defaults to on in production; set COOKIE_SECURE=0 only for
# local http testing of a production build.
# COOKIE_SECURE=1

# Stable key for Server Action encryption when running more than one app instance (optional).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=

# Do NOT set NODE_ENV in the Hostinger panel (Hostinger sets it itself).
# NODE_ENV=production
# PORT=3000  (Hostinger provides the port; 3000 is the default)
